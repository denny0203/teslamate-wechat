[Unit]
Description=Fill missing TeslaMate drive endpoints with authorized Amap lookup
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=/opt/teslamate-app/amap.json

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/teslamate-app/geocode_drives.py
ExecStartPost=/usr/bin/systemctl start tesla-app-sync.service
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/teslamate-app
