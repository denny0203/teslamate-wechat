<view class="map-page"><map id="footprint-map" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" polyline="{{polyline}}" markers="{{markers}}" binderror="mapError" show-location="{{false}}" enable-poi="{{false}}"/>
<view class="map-toolbar"><view class="segments"><view bindtap="switchScope" data-scope="all" class="{{scope==='all'?'selected':''}}">全部</view><view bindtap="switchScope" data-scope="month" class="{{scope==='month'?'selected':''}}">按月</view><view bindtap="switchScope" data-scope="day" class="{{scope==='day'?'selected':''}}">按日</view></view><picker wx:if="{{scope==='month'}}" range="{{months}}" value="{{monthIndex}}" bindchange="chooseMonth" aria-label="选择月份"><view class="picker"><text>{{monthLabel}}</text><text class="picker-arrow">⌄</text></view></picker><picker wx:elif="{{scope==='day'}}" mode="date" value="{{day}}" end="{{today}}" bindchange="chooseDay" aria-label="选择日期"><view class="picker"><text>{{day===today?'今天 · ':''}}{{dayLabel}}</text><text class="picker-arrow">⌄</text></view></picker><view wx:else class="muted">全部已记录历史 · 蓝色圆点为轨迹端点</view><view class="muted">{{busy?'正在读取…':count + '/' + total + ' 次可展示轨迹 · ' + distance + ' km'}}{{drawing?' · 绘制中':''}}</view><view wx:if="{{!busy && !count && !error}}" class="muted">当前范围暂无可用轨迹</view><view wx:if="{{notice}}" class="muted">{{notice}}</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view></view>
<view class="controls"><button bindtap="zoom" data-delta="1">＋</button><button bindtap="zoom" data-delta="-1">−</button><button bindtap="fit" class="fit" aria-label="显示当前范围的全部轨迹">全程</button></view>
</view>