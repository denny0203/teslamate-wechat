
.home-page{padding:24rpx 30rpx 16rpx;box-sizing:border-box;min-height:100vh;display:flex;flex-direction:column}.home-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12rpx}.vehicle-name{font-size:40rpx;font-weight:600;max-width:440rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.muted{font-size:22rpx;line-height:1.5}.state{font-size:22rpx;color:#d0d4dd;display:flex;align-items:center;gap:10rpx}.state-dot{width:10rpx;height:10rpx;border-radius:50%;background:#8798b0}.vehicle-panel{background:linear-gradient(160deg,#20242c,#15171c 75%);border-radius:28rpx;padding:0 28rpx 20rpx}.car-art{width:100%;height:190rpx;display:block}.range-row{display:flex;align-items:center;justify-content:space-between}.label{font-size:22rpx;color:#a2a7b2}.range-value{font-size:64rpx;font-weight:600;line-height:1.15;letter-spacing:-2rpx}.unit{font-size:22rpx;color:#a7adb8}.battery-block{text-align:right}.battery-value{font-size:44rpx;font-weight:500}.battery-track{height:5rpx;background:#343944;margin:14rpx 0 18rpx;border-radius:5rpx;overflow:hidden}.battery-track view{height:100%;background:#8db4a0}.estimate{display:flex;align-items:center;justify-content:space-between;font-size:23rpx;color:#e2e5eb}.chevron{color:#8792a5;margin-left:8rpx}.temperature{display:flex;gap:24rpx;margin-top:10rpx;color:#8e96a4;font-size:21rpx}.info-card{background:#181b21;border-radius:24rpx;padding:20rpx 26rpx;margin-top:16rpx}.section-label{font-size:26rpx;font-weight:500}.charge-summary{display:flex;align-items:center;justify-content:space-between;margin-top:10rpx;font-size:33rpx}.charge-battery{font-size:23rpx;color:#c0c6d1}.date{font-size:21rpx;color:#9199a7}.trip-metrics{display:flex;align-items:baseline;justify-content:space-between;margin:16rpx 0 12rpx}.metric-value{font-size:40rpx;font-weight:600}.trip-duration{font-size:26rpx}.trip-energy{font-size:21rpx;color:#b1b9c8}.address{font-size:23rpx;line-height:1.5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.trip-time{margin-top:5rpx}.sample-note{font-size:20rpx;color:#858c99;margin-top:14rpx;white-space:nowrap}.account-row{display:flex;justify-content:space-between;font-size:20rpx;color:#737b89;margin-top:auto;padding-top:12rpx}.error{margin-top:10rpx;padding:12rpx;font-size:22rpx}
@media(max-height:620px){.home-page{padding-top:16rpx}.car-art{height:138rpx}.info-card{padding:16rpx 24rpx;margin-top:12rpx}.range-value{font-size:56rpx}.trip-metrics{margin:10rpx 0}.vehicle-name{font-size:36rpx}}

/* Fill the available screen with the vehicle presentation, not an empty footer. */
.home-page{height:100vh;padding-bottom:22rpx}.home-header{flex-shrink:0;margin-bottom:20rpx}.vehicle-panel{flex:1;display:flex;flex-direction:column;min-height:350rpx;padding-bottom:24rpx}.car-art{flex:1;min-height:190rpx;height:0;width:100%;margin:4rpx 0 12rpx}.range-row,.battery-track,.estimate,.temperature{flex-shrink:0}.info-card{flex-shrink:0;padding:24rpx 26rpx;margin-top:20rpx}.sample-note{flex-shrink:0;margin-top:18rpx}.metric-label{font-size:21rpx;color:#969eac;font-weight:400;margin-bottom:10rpx}.trip-metrics{align-items:flex-start;margin:22rpx 0 18rpx}.trip-duration{font-size:28rpx}.trip-energy{font-size:23rpx}.address{padding-top:14rpx;border-top:1rpx solid #2a2e36}.vehicle-name:active{opacity:.65}
@media(max-height:620px){.home-page{padding-top:14rpx;padding-bottom:12rpx}.home-header{margin-bottom:12rpx}.vehicle-panel{min-height:300rpx;padding-bottom:16rpx}.car-art{min-height:130rpx;margin-bottom:4rpx}.info-card{padding:16rpx 24rpx;margin-top:12rpx}.trip-metrics{margin:12rpx 0}.metric-label{margin-bottom:6rpx}.address{padding-top:8rpx}.sample-note{margin-top:12rpx}}
