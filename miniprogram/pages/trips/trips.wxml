<view class="page"><view class="title">行程</view><view class="segments"><view data-view="recent" bindtap="switchView" class="{{view==='recent'?'selected':''}}">最近用车</view><view data-view="monthly" bindtap="switchView" class="{{view==='monthly'?'selected':''}}">按月汇总</view></view><view wx:if="{{busy && !loaded}}" class="empty">正在读取…</view><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{error}}" bindtap="load">重新加载</button><block wx:if="{{view==='recent'}}"><view class="muted">最近30次 · 按时间倒序 · 已显示{{total}}次</view><view wx:for="{{groups}}" wx:key="day" wx:for-item="group"><view class="day">{{group.day}}</view><view wx:for="{{group.rows}}" wx:key="id" class="card drive" bindtap="openDrive" data-id="{{item.id}}" hover-class="drive-pressed"><view class="address">{{item.start}} → {{item.end}} <text class="drive-arrow">›</text></view><view class="muted">{{item.time}}</view><view class="muted">{{item.distance}} · {{item.duration}}</view></view></view></block><block wx:else><view wx:for="{{months}}" wx:key="key" wx:for-item="month"><view class="row-between section-title"><text>{{month.label}}</text><text class="link" data-key="{{month.key}}" bindtap="expand">{{month.expanded?'收起':'展开'}}记录</text></view><view class="card"><view class="stat-grid"><view><view class="muted">行驶里程</view><view class="value">{{month.distance}}<text> km</text></view></view><view><view class="muted">行驶时长</view><view class="value small">{{month.duration}}</view></view><view><view class="muted">行驶次数</view><view class="value">{{month.count}}<text> 次</text></view></view><view><view class="muted">平均能耗</view><view class="value small">{{month.consumption}}<text> Wh/km</text></view></view><view><view class="muted">消耗电量</view><view class="value small">{{month.energyText}}<text> 度</text></view></view><view><view class="muted">消耗续航</view><view class="value small">{{month.rangeText}}<text> km</text></view></view></view><view class="row-between footnote"><text>能耗覆盖{{month.energyCount}}/{{month.count}}次</text><text class="link" bindtap="monthMap" data-key="{{month.key}}">本月足迹 ›</text></view><view wx:if="{{month.partial}}" class="footnote">部分里程、时长或续航未记录，汇总仅包含有效数据</view></view><block wx:if="{{month.expanded}}"><view wx:for="{{month.groups}}" wx:key="day" wx:for-item="group"><view class="day">{{group.day}}</view><view wx:for="{{group.rows}}" wx:key="id" class="card drive" bindtap="openDrive" data-id="{{item.id}}" hover-class="drive-pressed"><view class="address">{{item.start}} → {{item.end}} <text class="drive-arrow">›</text></view><view class="muted">{{item.time}}</view><view class="muted">{{item.distance}} · {{item.duration}}</view></view></view></block></view></block><view wx:if="{{loaded && !months.length}}" class="empty">暂无已结束行程</view></view>