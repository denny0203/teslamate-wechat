page{background:#090a0c;color:#f6f6f8;font-size:28rpx}.page{padding:30rpx 30rpx 50rpx}.title{font-size:48rpx;font-weight:600;margin-bottom:14rpx}.muted{color:#9b9ea8;font-size:23rpx;line-height:1.8}.card{background:#191b20;border:1rpx solid #2d3036;padding:30rpx;margin-top:24rpx;border-radius:28rpx}.subtitle,.stats{font-size:30rpx;font-weight:600;margin-bottom:16rpx}.day{margin:32rpx 0 6rpx;color:#b0b4bf;font-size:25rpx}.address{line-height:1.8;word-break:break-all}.metrics{margin-top:16rpx}.empty{padding:80rpx 0;text-align:center;color:#a0a6b3}.error,.warning{margin-top:24rpx;padding:22rpx;background:#30231f;color:#ffd6a1;border-radius:16rpx;font-size:24rpx}input{padding:24rpx 0;border-bottom:1rpx solid #3d4049;margin-bottom:20rpx}button{background:#315fff;color:white;font-size:28rpx;margin-top:22rpx}button.secondary{background:#2c3039;color:#c8cfdb}button[disabled]{opacity:.6}.drive-arrow{float:right;color:#8c969f;font-size:36rpx}.drive-pressed{opacity:.7}.section-title{font-size:35rpx;font-weight:600;margin-top:40rpx}.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32rpx 18rpx}.value{font-size:42rpx;margin-top:12rpx}.value text{font-size:22rpx;color:#aaa}.value.small{font-size:29rpx}.segments{display:flex;background:#1b1e25;border-radius:22rpx;padding:8rpx;margin:26rpx 0}.segments view{flex:1;text-align:center;padding:18rpx 4rpx;border-radius:16rpx;color:#a3a8b5}.segments .selected{background:#353e54;color:#fff}.row-between{display:flex;justify-content:space-between;align-items:center}.link{color:#9bb3ff;font-size:24rpx}.footnote{margin-top:20rpx;font-size:22rpx;color:#999;line-height:1.7}